# Copy this file to .env and fill in the API keys you need.
# Voqi uses third-party providers for the heavy lifting; you supply
# your own keys so you stay in control of cost, data residency, and
# rate limits.

# ─── Required ─────────────────────────────────────────────────────
OPENAI_API_KEY=                # main LLM (defaults to gpt-5.4)
DAILY_API_KEY=                 # WebRTC transport (free tier covers dev)
DEEPGRAM_API_KEY=              # speech-to-text — Nova-3 covers all 37 widget languages
CARTESIA_API_KEY=              # text-to-speech (agent's voice replies)
GOOGLE_API_KEY=                # Gemini, used for conversation-history summarisation

# Origin allowlist between widget and server. Comma-separated. The
# browser sends Origin automatically on cross-origin POSTs and respects
# the CORS allow-list returned here, so a widget embedded on an
# unlisted domain physically cannot reach /start. Default "*" is open
# (good for localhost demos); set explicitly in production.
# VOQI_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com

# Path to voqi.config.yaml. Defaults to ./voqi.config.yaml next to bot.py.
# VOQI_CONFIG=/path/to/your/voqi.config.yaml